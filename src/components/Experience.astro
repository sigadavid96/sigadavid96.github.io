---
import { siteConfig } from "../config";
import Org from "./Org.astro";
---

<section id="work" class="panel" data-section="work" aria-labelledby="work-h">
  <div class="wrap">
    <h2 id="work-h" class="h2 chalk-ink write">
      Work
    </h2>

    <ol class="roles">
      {
        siteConfig.experience.map((r, i) => (
          <li class="role" id={siteConfig.experience.findIndex((x) => x.org === r.org) === i ? `work-${r.org}` : undefined}>
            <div class="meta">
              <h3 class="where">
                <Org k={r.org} logo />
              </h3>
              <p class="title">{r.title}</p>
              <p class="loc muted"><span class="mono">{r.dateRange}</span> · {r.location}</p>
              <p class="biz">
                <em>Domain:</em> {r.business}
              </p>
            </div>
            <div class="body">
              {r.projects.map((pj) => (
                <div class="proj">
                  <h4 class="pn">{pj.name}</h4>
                  <p class="skills"><span class="sr-only">Key skills: </span>{pj.skills.join(" · ")}</p>
                  <ul class="pts">
                    {pj.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                  {pj.patent && (
                    <p class="patent" id="patent">
                      <span class="pk">U.S. Patent Application {pj.patent.number}</span>, filed {pj.patent.filed}:{" "}
                      <cite>{pj.patent.title}</cite>. {pj.patent.role}.
                    </p>
                  )}
                </div>
              ))}
              <p class="result">
                <span class="therefore" aria-label="therefore">∴</span>
                <span class="boxed">
                  {r.result}
                  <svg class="box draw" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true" style="--len:100">
                    <path pathLength="100" vector-effect="non-scaling-stroke" d="M1 2.5 C30 0.8 70 1.2 99 2 C99.5 15 99.3 27 98.8 38 C70 39.3 30 39.5 1.4 38.8 C0.5 27 0.7 14 1.2 1.8" />
                  </svg>
                </span>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .roles { list-style: none; margin: 0; padding: 0; }
  .role {
    display: grid;
    grid-template-columns: minmax(13rem, 19rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding: clamp(2.25rem, 4.5vw, 3.5rem) 0;
    border-top: 1px solid rgb(236 234 225 / 0.16);
  }
  .meta p { margin: 0; }
  .where {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    line-height: 1.15;
    margin: 0 0 0.6rem -0.3em;
  }
  .title { font-family: var(--f-display); font-size: 1.15rem; }
  .loc { font-size: 0.98rem; }
  .biz { margin-top: 1rem !important; font-size: 0.98rem; line-height: 1.5; color: var(--chalk-2); max-width: 30ch; }
  .biz em { color: var(--chalk); }

  .body { max-width: 70ch; }
  .proj { margin: 0 0 1.6rem; }
  .proj p { margin: 0; }
  .pn { font-family: var(--f-display); font-weight: 700; font-size: 1.2rem; line-height: 1.3; margin: 0; }
  .skills { font-family: var(--f-display); font-style: italic; color: var(--chalk-2); font-size: 1rem; margin-top: 0.15rem !important; }
  .pts { margin: 0.5rem 0 0; padding-left: 1.1rem; }
  .pts li { margin: 0.2rem 0; padding-left: 0.2rem; }
  .pts li::marker { content: "– "; color: var(--chalk-2); }
  .patent { display: block; margin-top: 0.7rem !important; padding-left: 1rem; border-left: 1px solid rgb(236 234 225 / 0.28); font-size: 0.98rem; color: var(--chalk-2); }
  .patent .pk { font-family: var(--f-display); color: var(--chalk); }
  .patent cite { font-family: var(--f-display); font-style: italic; color: var(--chalk); }

  .result {
    margin: 1.6rem 0 0;
    display: flex; align-items: center; gap: 0.75rem;
    font-family: var(--f-display);
    font-size: 1.12rem;
  }
  .therefore { font-size: 1.4rem; line-height: 1; color: var(--chalk-2); }
  .boxed { position: relative; padding: 0.6rem 1.1rem 0.65rem; }
  .box { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .box path { fill: none; stroke: var(--chalk); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; filter: url(#chalk-line); opacity: 0.85; }

  @media (max-width: 860px) {
    .role { grid-template-columns: 1fr; gap: 1.25rem; }
    .biz { max-width: none; }
  }
</style>
