---
import { siteConfig } from "../config";
import Org from "./Org.astro";
---

<section id="work" class="panel" data-section="work" aria-labelledby="work-h">
  <div class="wrap">
    <h2 id="work-h" class="h2 chalk-ink write">
      Work
    </h2>

    <ol class="roles">
      {
        siteConfig.experience.map((r, i) => (
          <li class="role">
            <div class="meta">
              <h3 class="where">
                <Org k={r.org} logo />
              </h3>
              <p class="title">{r.title}</p>
              <p class="loc muted"><span class="mono">{r.dateRange}</span> · {r.location}</p>
              <p class="biz">
                <em>Domain:</em> {r.business}
              </p>
            </div>
            <div class="body">
              {r.lemmas.map((l, j) => (
                <p class="lemma">
                  <b class="lh">
                    Lemma {i + 1}.{j + 1}
                  </b>{" "}
                  <span class="ln">({l.name}).</span> {l.text}
                </p>
              ))}
              <p class="result">
                <span class="therefore" aria-label="therefore">∴</span>
                <span class="boxed">
                  {r.result}
                  <svg class="box draw" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true" style="--len:100">
                    <path pathLength="100" vector-effect="non-scaling-stroke" d="M1 6 C30 2 70 3 99 5 C99.5 16 99.2 28 98.6 36 C70 38 30 39 1.4 37 C0.5 26 0.8 14 1.2 4" />
                  </svg>
                </span>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .roles { list-style: none; margin: 0; padding: 0; }
  .role {
    display: grid;
    grid-template-columns: minmax(13rem, 19rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding: clamp(2.25rem, 4.5vw, 3.5rem) 0;
    border-top: 1px solid rgb(236 234 225 / 0.16);
  }
  .meta p { margin: 0; }
  .where {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    line-height: 1.15;
    margin: 0 0 0.6rem -0.3em;
  }
  .title { font-family: var(--f-display); font-size: 1.15rem; }
  .loc { font-size: 0.98rem; }
  .biz { margin-top: 1rem !important; font-size: 0.98rem; line-height: 1.5; color: var(--chalk-2); max-width: 30ch; }
  .biz em { color: var(--chalk); }

  .body { max-width: 70ch; }
  .lemma { margin: 0 0 1.1rem; }
  .lh { font-family: var(--f-display); font-weight: 700; letter-spacing: 0.01em; }
  .ln { font-family: var(--f-display); font-style: italic; }

  .result {
    margin: 1.6rem 0 0;
    display: flex; align-items: center; gap: 0.75rem;
    font-family: var(--f-display);
    font-size: 1.12rem;
  }
  .therefore { font-size: 1.4rem; line-height: 1; color: var(--chalk-2); }
  .boxed { position: relative; padding: 0.4rem 1.1rem 0.45rem; }
  .box { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .box path { fill: none; stroke: var(--chalk); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; filter: url(#chalk-line); opacity: 0.85; }

  @media (max-width: 860px) {
    .role { grid-template-columns: 1fr; gap: 1.25rem; }
    .biz { max-width: none; }
  }
</style>
