---
import { siteConfig } from "../config";
import Org from "./Org.astro";
import Brace from "./Brace.astro";
---

<header id="top" class="hero panel" data-section="top">
  <div class="ghost" aria-hidden="true" style="top:9%; right:-4%; font-size:clamp(2rem,4vw,3.6rem); transform:rotate(-2deg)">
    softmax(<span>QK</span><sup>⊤</sup>/√<span>d</span><sub>k</sub>)<span>V</span>
  </div>
  <div class="ghost" aria-hidden="true" style="bottom:5%; right:-3%; font-size:clamp(1.6rem,3vw,2.6rem); transform:rotate(1.5deg)">
    p(x<sub>t</sub> | x<sub>&lt;t</sub>) = ∏ softmax(W h<sub>t</sub>)
  </div>
  <div class="ghost" aria-hidden="true" style="top:44%; right:6%; font-size:clamp(1.3rem,2.2vw,2rem); transform:rotate(-1deg)">
    ∇<sub>𝜃</sub> E<sub>q</sub>[log p − log q] + KL(q || p)
  </div>

  <div class="wrap hero-grid">
    <h1 class="name chalk-ink write">{siteConfig.name}</h1>

    <p class="role">
      Senior Data Scientist at <Org k="humana" />, building agentic LLM systems.
      Currently studying generative AI &amp; LLMs at
      <Org k="cmu" label="CMU School of Computer Science" href={siteConfig.now.link} />.
    </p>

    <div class="objective chalk-soft" role="math" aria-label="theta star equals the argmin over theta of research loss plus lambda times production loss">
      <span class="lhs">𝜃<sup>*</sup> =</span>
      <span class="argmin">arg min<sub>𝜃</sub></span>
      <span class="br" aria-hidden="true"></span>
      <span class="term">
        <span class="tex"><i>L</i><sub>research</sub>(𝜃)</span>
        <Brace />
        <span class="note">CMU SCS, GenAI &amp; LLMs, ’26–’27</span>
      </span>
      <span class="op">+</span>
      <span class="br" aria-hidden="true"></span>
      <span class="term lam">
        <button class="tex lambda" type="button" aria-describedby="lam-note" title="Try a different λ">
          𝜆
        </button>
        <Brace />
        <span class="note" id="lam-note" aria-live="polite">λ = 1: both count equally</span>
      </span>
      <span class="op">·</span>
      <span class="term">
        <span class="tex"><i>L</i><sub>production</sub>(𝜃)</span>
        <Brace />
        <span class="note">agentic LLMs at Humana</span>
      </span>
    </div>

    <p class="st">
      <span class="st-k">s.t.</span>
      <span>years in ML ≥ 7,</span>
      <span>patent filings = 3,</span>
      <span>CMU courses in progress = 3</span>
    </p>

    <ul class="contact" aria-label="Contact">
      <li><a href={`mailto:${siteConfig.social.email}`}>{siteConfig.social.email}</a></li>
      <li><a href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
    </ul>
  </div>
</header>

<style>
  .hero {
    min-height: calc(100svh - var(--tray-h));
    display: flex;
    align-items: center;
    padding-top: clamp(3rem, 7vh, 6rem);
    padding-bottom: clamp(3rem, 7vh, 5rem);
  }
  .hero-grid { width: 100%; }
  .name {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: clamp(3.25rem, 8vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0 0 1.75rem;
  }
  .role {
    font-size: clamp(1.15rem, 1.7vw, 1.45rem);
    line-height: 1.55;
    max-width: 40ch;
    color: var(--chalk-2);
    margin: 0 0 clamp(2.75rem, 6vh, 4.5rem);
  }
  .role :global(.org) { color: #fff; }

  .objective {
    font-family: var(--f-display);
    font-size: clamp(1.55rem, 3.4vw, 3.1rem);
    line-height: 1.1;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    column-gap: 0.42em;
    row-gap: 0.6em;
  }
  .objective sub, .objective sup { font-size: 0.55em; line-height: 0; }
  .objective sub { vertical-align: -0.35em; }
  .lhs, .argmin, .op { padding-top: 0.02em; }
  .argmin { display: inline-flex; flex-direction: column; align-items: center; line-height: 1; }
  .argmin sub { vertical-align: 0; line-height: 1.6; font-size: 0.55em; }
  .term { display: inline-flex; flex-direction: column; align-items: stretch; flex: none; }
  .lam { min-width: 3.2ch; }
  .term .tex { white-space: nowrap; text-align: center; }
  .term :global(.brace) { width: 100%; height: 0.36em; margin-top: 0.12em; }
  .term :global(.brace path) { fill: none; stroke: var(--chalk-2); stroke-width: 1.6; stroke-linecap: round; filter: url(#chalk-line); }
  .note {
    font-style: italic;
    font-size: clamp(0.85rem, 1vw, 1rem);
    line-height: 1.3;
    color: var(--chalk-2);
    text-align: center;
    margin-top: 0.35rem;
    max-width: 16ch;
    align-self: center;
  }
  .lam { margin-inline: -0.45em; }
  .lam .note { max-width: 13ch; min-height: 3.9em; }
  .br { display: none; }
  .lambda {
    appearance: none; border: 0; background: none; color: inherit; font: inherit;
    cursor: pointer; padding: 0 0.12em; border-radius: 0.2em;
    transition: background 0.3s var(--ease-out);
  }
  .lambda:hover { background: rgb(236 234 225 / 0.08); }

  .st {
    margin: clamp(2rem, 4vh, 3rem) 0 0;
    font-family: var(--f-display);
    font-style: italic;
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    color: var(--chalk-2);
    display: flex; flex-wrap: wrap; column-gap: 1.1em; row-gap: 0.2em;
  }
  .st-k { font-style: normal; color: var(--chalk); }

  .contact {
    list-style: none; padding: 0; margin: clamp(2.5rem, 6vh, 4rem) 0 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem;
    font-family: var(--f-display); font-size: 1.1rem;
  }

  @media (max-width: 640px) {
    .objective { column-gap: 0.32em; font-size: 1.75rem; }
    .br { display: block; flex-basis: 100%; height: 0; }
    .note { max-width: 20ch; }
    .lam { margin-inline: 0; }
  }
</style>
