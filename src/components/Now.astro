---
import { siteConfig } from "../config";
import Org from "./Org.astro";
const n = siteConfig.now;
---

<section id="now" class="panel now" data-section="now" aria-labelledby="now-h">
  <div class="ghost" aria-hidden="true" style="top:14%; right:4%; font-size:clamp(1.6rem,3vw,2.6rem); transform:rotate(-1.5deg)">
    h′ = σ(W<sub>v</sub>v ⊕ W<sub>t</sub>t)
  </div>
  <div class="wrap">
    <h2 id="now-h" class="h2 chalk-ink write">
      Currently studying
      <span class="sub">{n.dateRange}</span>
    </h2>

    <p class="program">
      <Org k="cmu" label="Carnegie Mellon" href={n.link} />
      <span class="muted">{n.school}.</span>
      {n.program}. <span class="muted">{n.note}.</span>
    </p>

    <ol class="courses" aria-label="Coursework">
      {
        n.courses.map((c) => (
          <li>
            <span class="code mono">{c.code}</span>
            <span class="cname">{c.name}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .program {
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    max-width: 52ch;
    margin: 0 0 clamp(2.5rem, 5vw, 3.5rem);
  }
  .courses { list-style: none; margin: 0; padding: 0; }
  .courses li {
    display: grid;
    grid-template-columns: minmax(6.5rem, 9rem) 1fr;
    align-items: baseline;
    gap: 1.5rem;
    padding: clamp(1rem, 2vw, 1.4rem) 0;
    border-top: 1px solid rgb(236 234 225 / 0.16);
  }
  .courses li:last-child { border-bottom: 1px solid rgb(236 234 225 / 0.16); }
  .code { font-size: clamp(1rem, 1.4vw, 1.2rem); color: var(--chalk-2); }
  .cname {
    font-family: var(--f-display);
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  @media (max-width: 560px) {
    .courses li { grid-template-columns: 4.6rem 1fr; gap: 0.9rem; }
  }
</style>
