---
import { siteConfig } from "../config";
import Org from "./Org.astro";
---

<section id="honors" class="panel" data-section="honors" aria-labelledby="hon-h">
  <div class="wrap">
    <h2 id="hon-h" class="h2 chalk-ink write">Honors</h2>

    <ol class="honors">
      {
        siteConfig.honors.map((h) => (
          <li class="honor">
            <span class="when mono">{h.date}</span>
            <div class="what">
              <p class="title">
                {h.title} <Org k={h.org} label={h.issuer} />
              </p>
              <p class="why">{h.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .honors { list-style: none; margin: 0; padding: 0; }
  .honor {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.2rem 0;
    border-top: 1px solid rgb(236 234 225 / 0.16);
  }
  .honor:last-child { border-bottom: 1px solid rgb(236 234 225 / 0.16); }
  .when { color: var(--chalk-2); padding-top: 0.35rem; }
  .what p { margin: 0; }
  .title {
    font-family: var(--f-display);
    font-size: clamp(1.3rem, 1.9vw, 1.6rem);
    line-height: 1.3;
  }
  .title :global(.org) { font-size: 0.72em; vertical-align: 0.12em; margin-left: 0.3em; }
  .why { color: var(--chalk-2); margin-top: 0.3rem !important; max-width: 68ch; }

  @media (max-width: 560px) {
    .honor { grid-template-columns: 4.6rem minmax(0, 1fr); gap: 0.9rem; }
    .when { font-size: 0.8rem; padding-top: 0.45rem; }
  }
</style>
