---
import { siteConfig } from "../config";
---

<section id="references" class="panel" data-section="references" aria-labelledby="ref-h">
  <div class="ghost" aria-hidden="true" style="top:8%; right:3%; font-size:clamp(1.5rem,2.8vw,2.4rem); transform:rotate(1deg)">
    W ≈ Q(W ⊙ M), &nbsp;M ∈ {"{0,1}"}<sup>d</sup>
  </div>
  <div class="wrap">
    <h2 id="ref-h" class="h2 chalk-ink write">
      References
      <span class="sub">Papers I re-implemented and models I built from scratch.</span>
    </h2>

    <ol class="bib">
      {
        siteConfig.research.map((r) => (
          <li class="entry">
            <span class="key mono">[{r.key}]</span>
            <div class="cite">
              <p class="t">
                {r.link ? (
                  <a href={r.link} target="_blank" rel="noopener noreferrer">
                    {r.title}
                  </a>
                ) : (
                  r.title
                )}
                <span class="venue">{r.venue}</span>
              </p>
              <p class="recipe">
                {r.recipe} <span class="arrow" aria-hidden="true">→</span>
                <span class="sr-only">result:</span> <span class="res">{r.result}</span>
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .bib {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 5rem);
  }
  .entry {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.4rem 0;
    border-top: 1px solid rgb(236 234 225 / 0.16);
  }
  .key { color: var(--chalk-3); font-size: 0.88rem; padding-top: 0.3rem; }
  .cite p { margin: 0; }
  .t {
    font-family: var(--f-display);
    font-size: clamp(1.3rem, 1.9vw, 1.6rem);
    line-height: 1.2;
    margin-bottom: 0.45rem !important;
  }
  .venue { display: block; font-style: italic; font-size: 0.62em; color: var(--chalk-2); margin-top: 0.3rem; }
  .recipe { font-size: 1.02rem; line-height: 1.55; color: var(--chalk-2); }
  .arrow { color: var(--chalk); }
  .res { color: var(--chalk); font-family: var(--f-display); font-style: italic; white-space: nowrap; }

  @media (max-width: 860px) {
    .bib { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .entry { grid-template-columns: 1fr; gap: 0.3rem; }
    .res { white-space: normal; }
  }
</style>
